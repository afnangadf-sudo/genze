# Copy to .env and fill in. The app MUST boot with every optional key empty:
# unconfigured providers report "not configured", auth and pages work fully offline.
# Only DATABASE_URL / REDIS_URL / JWT secrets matter for local dev.

# --- Core ---
DATABASE_URL=postgresql://genze:genze@localhost:5432/genze
REDIS_URL=redis://localhost:6379
API_PORT=4000
APP_URL=http://localhost:3000
JWT_ACCESS_SECRET=            # required: min 32 chars (dev: auto-generated with a warning if empty)
JWT_REFRESH_SECRET=           # required: min 32 chars (dev: auto-generated with a warning if empty)

# --- Email (verification + password reset) ---
# If RESEND_API_KEY is empty, the API runs in dev mode and prints tokens to its console.
RESEND_API_KEY=
EMAIL_FROM=Genze <noreply@localhost>

# --- Google OAuth login (both required; endpoints return 503 NOT_CONFIGURED otherwise) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Sign in with Apple (mobile; optional) ---
# The Services ID (client id) the mobile app uses when requesting an Apple
# identity token. Unset => POST /api/v1/auth/apple returns 503
# APPLE_NOT_CONFIGURED (fail closed). Verification is server-side against
# Apple's JWKS (https://appleid.apple.com/auth/keys); the token must be
# issued by Apple (iss), for this client id (aud), unexpired (exp), with a
# matching nonce when the app sends one.
APPLE_CLIENT_ID=

# --- AI providers (all optional) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENAI_API_KEY=
KLING_API_KEY=
STEEL_API_KEY=
ELEVENLABS_API_KEY=

# --- Chat model overrides for the smart router (optional; ids only) ---
# Defaults (Oct 2026 research — re-verify ids/prices before launch):
#   ANTHROPIC_CHAT_MODEL=claude-haiku-5.5  ANTHROPIC_REASONING_MODEL=claude-sonnet-5.5
#   OPENAI_CHAT_MODEL=gpt-6-luna           OPENAI_REASONING_MODEL=gpt-6.1-sol
ANTHROPIC_CHAT_MODEL=
ANTHROPIC_REASONING_MODEL=
OPENAI_CHAT_MODEL=
OPENAI_REASONING_MODEL=

# --- Provider kill switches: comma-separated provider ids to force-disable ---
# e.g. PROVIDER_DISABLED=anthropic,kling
PROVIDER_DISABLED=

# --- Files (Step 3) ---
MAX_FILE_MB=50              # per-file upload cap; rejected with 413 FILE_TOO_LARGE
STORAGE_DIR=                # unset => ./storage under the API working directory
SIGNED_LINK_TTL_SEC=900     # signed download link lifetime (seconds)
FILE_CONTEXT_CHARS=60000    # max extracted file text injected into one chat reply

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
# Show the "Continue with Google" button only when the API has OAuth configured:
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false

# --- Research + Write (Step 4) ---
TAVILY_API_KEY=             # unset => research/fact-check return 503 SEARCH_NOT_CONFIGURED (never fake)
BRAVE_SEARCH_API_KEY=       # alternative search providers; pick with SEARCH_PROVIDER
SERPER_API_KEY=
SEARCH_PROVIDER=tavily      # tavily|brave|serper|stub (stub = test-only canned results)
FETCH_TIMEOUT_MS=15000      # per-page fetch timeout for the research reader
FETCH_MAX_CHARS=30000       # max extracted text kept per fetched page
RESEARCH_MAX_SOURCES=8      # pages opened per research job
RESEARCH_MAX_SEARCHES=6     # search queries per research job

# --- Agent schedules (Step 7b) ---
# Tick interval (ms) for the in-process agent scheduler. Default 60000.
AGENT_SCHEDULER_INTERVAL_MS=

# --- Connectors (MCP) + Skills (Step 6) ---
# Token encryption for stored connector OAuth tokens: 64 hex chars (32 bytes).
# Dev: auto-generated at boot with a loud warning. Prod: refuses to boot without it.
# Step 8 reuses this key for encrypted browser-site login profiles (with a
# distinct purpose label) — no separate BROWSER_VAULT_KEY needed.
TOKEN_ENCRYPTION_KEY=
# Per-connector OAuth apps (all optional; a connector reports "not configured"
# until its client id + secret are both set). MCP endpoint URLs are
# env-overridable; the defaults below are the verified vendor endpoints.
NOTION_MCP_CLIENT_ID=
NOTION_MCP_CLIENT_SECRET=
NOTION_MCP_URL=https://mcp.notion.com/mcp
SLACK_MCP_CLIENT_ID=
SLACK_MCP_CLIENT_SECRET=
SLACK_MCP_URL=https://mcp.slack.com/mcp
GITHUB_MCP_CLIENT_ID=
GITHUB_MCP_CLIENT_SECRET=
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
DROPBOX_MCP_CLIENT_ID=
DROPBOX_MCP_CLIENT_SECRET=
DROPBOX_MCP_URL=https://mcp.dropbox.com/mcp
# Google Workspace (Drive/Gmail/Calendar): no hosted MCP yet (Developer Preview
# gated) — connector availability is "not_available_yet" until Google ships it.
# OneDrive: "coming_later" (enterprise-gated). No env vars for these yet.

# --- Agent (Step 7) ---
# Cloud browser for the autonomous agent. Unset => agent creation returns
# 503 BROWSER_NOT_CONFIGURED (the API never fakes a browser run).
STEEL_API_KEY=
STEEL_API_BASE=             # default https://api.steel.dev
AGENT_MAX_STEPS=30          # per-task step cap
AGENT_MAX_MINUTES=15        # per-task wall-clock cap (minutes)
AGENT_MAX_SPEND_USD=2       # per-task spend cap (browser estimate + LLM cost, USD)

# --- Studio: images, voice, Video Director (Step 9) ---
# ELEVENLABS_API_KEY is listed above with the other provider keys (optional;
# used for text-to-speech when it covers the requested language).
VIDEO_MAX_SECONDS_PER_PROJECT=900  # per-project generated-video cap (seconds)
VIDEO_MAX_SPEND_USD=20              # per-project estimated spend cap (USD)
FFMPEG_PATH=                       # unset => "ffmpeg" from PATH (video assembly shells out to it)
